{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix chez-abaya",
  "buildCommand": "npm run build --prefix chez-abaya",
  "outputDirectory": "chez-abaya/out",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/opengraph-image",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    }
  ]
}
